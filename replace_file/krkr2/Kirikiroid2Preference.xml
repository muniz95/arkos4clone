<?xml version="1.0" encoding="UTF-8"?>
<GlobalPreference>
    <!-- Image cache limit 30MB (unit: bytes) -->
    <!-- 20-40MB recommended on 917MB devices -->
    <Item key="graphicCacheLimit" value="31457280"/>

    <!-- Texture compression: etc2/half/none -->
    <!-- ETC2 compression cuts video memory by 75%; supported by the Mali-G31 -->
    <Item key="ogl_compress_tex" value="etc2"/>

    <!-- Maximum texture size; anything larger is scaled down -->
    <!-- 512-1024 is enough for a 720p screen -->
    <Item key="ogl_max_texsize" value="768"/>

    <!-- Disable the BPG decoder (saves memory) -->
    <Item key="enable_bpg" value="0"/>

    <!-- Language (zh_CN/ja_JP/en_US) -->
    <Item key="language" value="zh_CN"/>
</GlobalPreference>
