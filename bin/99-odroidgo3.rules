# ============================================================
# Fix the GO-Super Gamepad controller mapping and the system freeze issue
# ============================================================

# Rule 1: create a fixed symlink and try to block a specific default symlink (if the udev version supports it)
# This is the first line of defense; SYMLINK-= works directly in some environments and prevents the given path from being created
SUBSYSTEM=="input", ATTRS{name}=="GO-Super Gamepad", ACTION=="add", \
    SYMLINK+="input/by-path/platform-odroidgo3-joypad-event-joystick", \
    SYMLINK-="input/by-path/platform-ff300000.usb-usb-0:1.2:1.0-event-joystick"

# Rule 2 (second line of defense): remove every system-generated symlink starting with "platform-ff300000"
# Covers all variants such as usb-usb and usb-usbv2, complementing SYMLINK-=
# Uses the * wildcard to clear them all at once, so path differences leave nothing behind
# Deleting symlinks does not trigger a uevent, so it is completely safe and will not freeze the system
SUBSYSTEM=="input", ATTRS{name}=="GO-Super Gamepad", ACTION=="add", \
    RUN+="/bin/sh -c 'rm -f /dev/input/by-path/platform-ff300000*'"

# Rule 3 (defensive): block any action on non-add events to avoid accidental triggers
SUBSYSTEM=="input", ATTRS{name}=="GO-Super Gamepad", ACTION!="add", \
    OPTIONS="ignore_device"